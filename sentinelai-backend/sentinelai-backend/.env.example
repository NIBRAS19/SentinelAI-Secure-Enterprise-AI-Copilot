APP_ENV=development
APP_SECRET=change-me-in-production-please

DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinelai
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# LLM provider: "none" (canned/templated answers, zero config), "anthropic", or "openai"
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings: "hash" (zero-config, dependency-free) or "openai" (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=hash
RERANKER_PROVIDER=lexical
RETRIEVAL_MIN_SCORE=0.42

STORAGE_DIR=/app/storage
MAX_UPLOAD_MB=25

# true = process uploads inline via BackgroundTasks (no worker needed, good for local dev)
# false = enqueue to the Celery worker service
PROCESS_DOCUMENTS_INLINE=true

CORS_ORIGINS=["http://localhost:3000"]
