APP_ENV=development
APP_SECRET=local-dev-secret

# SQLite — a file called sentinelai.db in the backend folder
DATABASE_URL=sqlite+aiosqlite:///./sentinelai.db

JWT_SECRET=local-dev-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Zero-config: no API key needed
LLM_PROVIDER=none
EMBEDDING_PROVIDER=hash
RERANKER_PROVIDER=lexical
RETRIEVAL_MIN_SCORE=0.42

STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# CRITICAL: inline processing avoids needing Redis/Celery
PROCESS_DOCUMENTS_INLINE=true

CORS_ORIGINS=["http://localhost:3000"]
