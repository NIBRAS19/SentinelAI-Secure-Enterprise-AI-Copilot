# This build runs entirely on mock data (see lib/mock/*) and does not call
# a real backend yet. These variables are placeholders for the day a
# SentinelAI API (see PRD §12, §30) exists to wire up.

NEXT_PUBLIC_APP_ENV=development

# Base URL of the SentinelAI backend API, once it exists.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
